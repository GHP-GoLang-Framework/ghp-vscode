{
  "comments": {
    "blockComment": ["<!--", "-->"]
  },
  "brackets": [
    ["<!--", "-->"],
    ["<", ">"],
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "<go:", "close": "/>", "notIn": ["comment", "string"] },
    { "open": "<go=", "close": "/>", "notIn": ["comment", "string"] },
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" },
    { "open": "`", "close": "`" },
    { "open": "<!--", "close": " -->" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["`", "`"],
    ["<", ">"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "<go:(if|else|switch|case|default|for)\\b[^>]*/>\\s*$|<(?!\\?|area|base|br|col|frame|hr|html|img|input|link|meta|param|embed|source|track|wbr)([a-zA-Z][a-zA-Z0-9:._-]*)(?:\\s[^>]*)?>(?![^<]*</\\2>)\\s*$",
    "decreaseIndentPattern": "^\\s*(<go:(endif|endswitch|endfor)/>|<go:(else|case|default)\\b[^>]*/>|</[a-zA-Z][a-zA-Z0-9:._-]*\\s*>)"
  },
  "onEnterRules": [
    {
      "beforeText": "<go:(if|else|switch|case|default|for)\\b[^>]*/>\\s*$",
      "action": { "indent": "indent" }
    }
  ],
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\$\\^\\&\\*\\(\\)\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\s]+)"
}
